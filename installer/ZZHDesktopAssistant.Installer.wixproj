<Project Sdk="WixToolset.Sdk/4.0.6">
  <PropertyGroup>
    <OutputName>ZZHDesktopAssistant-Setup</OutputName>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <SuppressValidation>true</SuppressValidation>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>
      DesktopExe=$(DesktopExe);
      SensorServiceExe=$(SensorServiceExe);
      ThirdPartyNotices=$(ThirdPartyNotices);
      AppIcon=$(AppIcon)
    </DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Package.wxs" />
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.6" />
  </ItemGroup>
</Project>
